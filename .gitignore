/pkg/
/tmp/
*.gem
/notes/

# A run's output: checkpoints, an exported model and a journal, which are
# gigabytes of binaries rather than anything to commit. `Torobi::Runner`
# writes here (docs/plan.md section 11.4).
/runs/

# Not anchored: cargo builds a target directory beside every manifest, and
# an unanchored rule is the only one that covers the next one. engine/target
# reached the history once, with a 100 MB metallib inside it.
target/
# Written by engine/check/generate.rb every time the check runs. Committed
# once, and by the time anyone looked the DSL had moved and the check was
# holding the engine to a shape it no longer produces.
engine/check/*.json
lib/torobi/torobi.bundle
lib/torobi/*/torobi.bundle
lib/torobi/*/torobi.so
lib/torobi/mlx.metallib
# NVIDIA's JIT headers, staged here to travel in the Linux platform gem.
lib/include/
